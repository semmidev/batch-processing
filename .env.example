# Server
SERVER_PORT=8080
GRPC_PORT=9090
WORKER_COUNT=10
POLL_INTERVAL_SECONDS=2
ITEMS_PER_POLL=50

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=middleware_db
DB_USER=middleware_user
DB_PASSWORD=YourStrong!Password
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# System C
SYSTEM_C_BASE_URL=http://localhost:9000
SYSTEM_C_API_KEY=system-c-key
SYSTEM_C_TIMEOUT_SECONDS=15
SYSTEM_C_RATE_LIMIT_PER_SECOND=100

# Circuit Breaker
CB_MAX_REQUESTS_HALF_OPEN=5
CB_OPEN_TIMEOUT_SECONDS=60

# Webhook
WEBHOOK_MAX_RETRIES=5
WEBHOOK_SIGNING_ALGORITHM=sha256

# API Security
API_KEY_HEADER=Authorization
VALID_API_KEYS=key1,key2
TIMESTAMP_TOLERANCE_SECONDS=300

# Logging
LOG_LEVEL=info
